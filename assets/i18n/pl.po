msgstr ""
"Utwory odtwarzane tutaj są zapisywane w {file}. Ten plik nigdy nie jest "
"wysyłany."

#: src/ui/settings.rs:2417
msgid "Sign-in"
msgstr "Logowanie"

#: src/ui/settings.rs:2420
